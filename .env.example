# ==========================================
# Chirp - Environment Configuration Template
# ==========================================
# Copy this file to backend/.env or root .env and fill in real values.
# DO NOT commit real secrets or credentials to version control.

# ------------------------------------------
# Database (PostgreSQL / Neon)
# ------------------------------------------
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require&connection_limit=60&pool_timeout=30"

# ------------------------------------------
# Redis Cache & Matchmaking
# ------------------------------------------
# For local Docker Compose use: redis://redis:6379
# For host/local standalone use: redis://127.0.0.1:56863
REDIS_URL="redis://redis:6379"

# ------------------------------------------
# Gemini AI Configuration
# ------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.1-flash-lite"
AI_SUGGESTION_COOLDOWN_SECONDS=10
AI_SUGGESTION_DAILY_LIMIT=5
AI_GLOBAL_RPM_LIMIT=15
AI_GLOBAL_RPD_LIMIT=500

# ------------------------------------------
# Backend CORS & Security
# ------------------------------------------
# Origin permitted by NestJS REST and WebSocket gateways
FRONTEND_URL="http://localhost:3000"
# Reverse proxy trust setting (e.g. 1, true, or loopback when behind Nginx/Cloudflare)
# TRUST_PROXY=1

# ------------------------------------------
# Frontend Public Variables
# ------------------------------------------
# Public URL of the backend API used by client-side browser code (REST and Socket.IO)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"

