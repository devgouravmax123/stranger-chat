generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  isBanned   Boolean  @default(false)

  // ==========================================
  // PROFILE
  // ==========================================

  username String? @unique
  age      Int?
  gender   String?
  avatar   String?

  // Matching / profile information
  language  String?  @default("English")
  interests String[] @default([])
  goal      String?  @default("casual-chat")

  // ==========================================
  // STRANGER CHATS
  // ==========================================

  chatsAsUserA Chat[] @relation("ChatUserA")
  chatsAsUserB Chat[] @relation("ChatUserB")

  // ==========================================
  // MESSAGES & REACTIONS
  // ==========================================

  sentMessages Message[]  @relation("SentMessages")
  reactions    Reaction[]

  // ==========================================
  // REPORTS
  // ==========================================

  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")

  // ==========================================
  // BLOCKS
  // ==========================================

  blocksMade     Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")

  // ==========================================
  // FRIEND REQUESTS
  // ==========================================

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")

  // ==========================================
  // FRIENDSHIPS
  // ==========================================

  friendshipsAsUserA Friendship[] @relation("FriendshipUserA")
  friendshipsAsUserB Friendship[] @relation("FriendshipUserB")

  // ==========================================
  // NOTIFICATIONS
  // ==========================================

  notifications Notification[]

  @@index([isBanned, lastSeenAt(sort: Desc)])
  @@index([lastSeenAt(sort: Desc)])
}

model Chat {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  userAId String
  userBId String

  userA User @relation("ChatUserA", fields: [userAId], references: [id])
  userB User @relation("ChatUserB", fields: [userBId], references: [id])

  messages Message[]
  reports  Report[]

  // Private friend chat
  friendship Friendship? @relation("FriendshipChat")

  @@index([userAId])
  @@index([userBId])
  @@index([createdAt])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  // Delivery & Seen & Delete Status
  status      String    @default("sent")
  deliveredAt DateTime?
  seenAt      DateTime?
  deletedAt   DateTime?

  // Reply Relationship
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Reactions
  reactions Reaction[]

  chatId   String
  senderId String

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation("SentMessages", fields: [senderId], references: [id])

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  createdAt DateTime @default(now())

  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Report {
  id        String       @id @default(uuid())
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  reporterId String
  reportedId String
  chatId     String?

  reporter User  @relation("Reporter", fields: [reporterId], references: [id])
  reported User  @relation("Reported", fields: [reportedId], references: [id])
  chat     Chat? @relation(fields: [chatId], references: [id])

  @@index([reportedId])
  @@index([reporterId])
  @@index([status])
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockerId String
  blockedId String

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId])
}

model FriendRequest {
  id        String              @id @default(uuid())
  status    FriendRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  senderId   String
  receiverId String

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id])
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userAId String
  userBId String

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id])

  // Private 1-to-1 friend chat
  chatId String? @unique

  chat Chat? @relation("FriendshipChat", fields: [chatId], references: [id])

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([userAId, createdAt(sort: Desc)])
  @@index([userBId, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // FRIEND_REQUEST, FRIEND_ACCEPTED, NEW_MESSAGE
  title     String
  body      String
  data      String?  // JSON string e.g. { senderId, friendId, etc. }
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
