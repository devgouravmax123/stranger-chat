generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  isBanned   Boolean  @default(false)

  // Profile
  username String? @unique
  age      Int?
  gender   String?
  avatar   String?

  // Stranger chats
  chatsAsUserA Chat[] @relation("ChatUserA")
  chatsAsUserB Chat[] @relation("ChatUserB")

  // Messages
  sentMessages Message[] @relation("SentMessages")

  // Reports
  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")

  // Blocks
  blocksMade     Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")

  // Friend requests
  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")

  // Friendships
  friendshipsAsUserA Friendship[] @relation("FriendshipUserA")
  friendshipsAsUserB Friendship[] @relation("FriendshipUserB")
}

model Chat {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  userAId String
  userBId String

  userA User @relation("ChatUserA", fields: [userAId], references: [id])
  userB User @relation("ChatUserB", fields: [userBId], references: [id])

  messages Message[]
  reports  Report[]

  // If this chat belongs to a friendship,
  // this connects the private friend chat.
  friendship Friendship? @relation("FriendshipChat")

  @@index([userAId])
  @@index([userBId])
  @@index([createdAt])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  chatId   String
  senderId String

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation("SentMessages", fields: [senderId], references: [id])

  @@index([chatId, createdAt])
  @@index([senderId])
}

model Report {
  id        String       @id @default(uuid())
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  reporterId String
  reportedId String
  chatId     String?

  reporter User  @relation("Reporter", fields: [reporterId], references: [id])
  reported User  @relation("Reported", fields: [reportedId], references: [id])
  chat     Chat? @relation(fields: [chatId], references: [id])

  @@index([reportedId])
  @@index([reporterId])
  @@index([status])
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockerId String
  blockedId String

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model FriendRequest {
  id        String              @id @default(uuid())
  status    FriendRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  senderId   String
  receiverId String

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id])
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userAId String
  userBId String

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id])

  // Private 1-to-1 friend chat
  chatId String? @unique

  chat Chat? @relation("FriendshipChat", fields: [chatId], references: [id])

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}
